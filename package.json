{
  "name": "insurance-claims-platform",
  "version": "1.0.0",
  "description": "Multi-tenant insurance claims platform with async processing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/workers/claims.worker.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit up:pg",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tantan2395/insurance-claims-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tantan2395/insurance-claims-platform/issues"
  },
  "homepage": "https://github.com/tantan2395/insurance-claims-platform#readme",
  "dependencies": {
    "express": "^4.18.0",
    "drizzle-orm": "^0.29.0",
    "postgres": "^3.4.0",
    "@neondatabase/serverless": "^0.9.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.3.0",
    "zod": "^3.22.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-async-errors": "^3.1.1",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/bcrypt": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/passport": "^1.0.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "drizzle-kit": "^0.20.0",
    "vitest": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^6.3.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  }
}